 },
 {
  "id": "A|src/learnPaths/rekenenTot100Nieuwkomers.js|3026",
  "en": "Count on in tens. What comes after ${n}?",
  "ar": "عُدّ بالعشرات. ماذا يأتي بعد ${n}؟"
 },
 {
  "id": "A|src/learnPaths/rekenenTot100Nieuwkomers.js|9823",
  "en": "A ball costs 12 euros. A cap costs 15 euros. How many euros together?",
  "ar": "الكرة ثمنها 12 يورو. القبعة ثمنها 15 يورو. كم يورو معًا؟"
 },
 {
  "id": "A|src/learnPaths/rekenenTot100Nieuwkomers.js|10414",
  "en": "You have 50 euros. You buy shoes for 35 euros. How many euros do you have left?",
  "ar": "عندك 50 يورو. تشتري حذاءً بـ 35 يورو. كم يورو بقي معك؟"
 },
 {
  "id": "A|src/learnPaths/rekenenTot100Nieuwkomers.js|10991",
  "en": "There are 40 chairs. 25 more chairs are added. How many chairs are there now?",
  "ar": "هناك 40 كرسيًا. يُضاف 25 كرسيًا. كم كرسيًا هناك الآن؟"
 },
 {
  "id": "A|src/learnPaths/rekenenTot100Nieuwkomers.js|11598",
  "en": "There are 48 people on the bus. 19 people get off. How many people are still on the bus?",
  "ar": "في الحافلة 48 شخصًا. ينزل 19 شخصًا. كم شخصًا بقي؟"
 },
 {
  "id": "A|src/learnPaths/rekenenTot100Nieuwkomers.js|12158",
  "en": "A book costs 23 euros. A pen costs 8 euros. How many euros together?",
  "ar": "الكتاب ثمنه 23 يورو. القلم ثمنه 8 يورو. كم يورو معًا؟"
 },
 {
  "id": "A|src/learnPaths/rekenenTot20Nieuwkomers.js|2840",
  "en": "Count on. What comes after ${n}?",
  "ar": "عُدّ. ماذا يأتي بعد ${n}؟"
 },
 {
  "id": "A|src/learnPaths/rekenenTot20Nieuwkomers.js|9218",
  "en": "There are 6 children in the class. 3 more children come. How many children are there now?",
  "ar": "في الصف 6 أطفال. يأتي 3 أطفال آخرون. كم طفلًا هناك الآن؟"
 },
 {
  "id": "A|src/learnPaths/rekenenTot20Nieuwkomers.js|9746",
  "en": "You have 10 pencils. You give 4 away. How many pencils do you have left?",
  "ar": "عندك 10 أقلام رصاص. تعطي 4 منها. كم قلمًا بقي معك؟"
 },
 {
  "id": "A|src/learnPaths/rekenenTot20Nieuwkomers.js|10286",
  "en": "There are 7 books in the bag. You add 5. How many books are there now?",
  "ar": "في الحقيبة 7 كتب. تضيف 5. كم كتابًا هناك الآن؟"
 },
 {
  "id": "A|src/learnPaths/rekenenTot20Nieuwkomers.js|10819",
  "en": "There are 15 chairs. 8 chairs are taken. How many chairs are empty?",
  "ar": "هناك 15 كرسيًا. 8 كراسٍ مشغولة. كم كرسيًا فارغًا؟"
 },
 {
